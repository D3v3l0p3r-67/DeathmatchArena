# Copy to .env.local for local overrides.

# Colyseus endpoint.
#   development -> ws://localhost:2567
#   production  -> wss://<your-app>.colyseus.cloud
# Leave unset to derive it from the page origin, which is correct when the server
# also serves the client build.
VITE_SERVER_URL=ws://localhost:2567

# Force the debug overlay on (it can also be toggled at runtime with F3, or via ?debug=1).
VITE_DEBUG=false
