# Copy to .env for local overrides. Never commit real secrets.

# Port the Colyseus server binds to (Colyseus Cloud injects its own PORT).
PORT=2567

# development | production
NODE_ENV=development

# Comma-separated allowed origins, or * for any (development default).
CORS_ORIGIN=*

# Match tuning. MIN_PLAYERS=2 keeps local testing to two browser windows.
MIN_PLAYERS=2
MAX_PLAYERS=10
COUNTDOWN_MS=5000
RESULTS_MS=12000

# Arena id from shared/game/arena.ts. Empty = default arena.
ARENA_ID=

# Tooling. Both default to on in development and off in production.
ENABLE_MONITOR=true
ENABLE_PLAYGROUND=true
VERBOSE_LOGGING=true

# Serve the built client from this process (single-service deployments).
# Relative paths are resolved against the server module directory, then the cwd.
SERVE_CLIENT=false
CLIENT_DIST_PATH=../../client/dist
