# Copy to .env for local overrides. Never commit real secrets.

# Port the Colyseus server binds to (Colyseus Cloud injects its own PORT).
PORT=2567

# development | production
NODE_ENV=development

# Comma-separated allowed origins, or * for any (development default).
CORS_ORIGIN=*

# Match tuning. These are SEEDS: they set the defaults an administrator then edits
# on top of at /admin, and they are what "reset to default" restores.
# MIN_PLAYERS=2 keeps local testing to two browser windows.
MIN_PLAYERS=2
MAX_PLAYERS=10
COUNTDOWN_MS=5000
RESULTS_MS=12000

# Arena id to prefer for new rooms. Empty = the default arena.
# Arenas are administered data; the ids are whatever /admin holds.
ARENA_ID=

# Tooling. Both default to on in development and off in production.
ENABLE_MONITOR=true
ENABLE_PLAYGROUND=true
VERBOSE_LOGGING=true

# Serve the built client from this process (single-service deployments).
# Relative paths are resolved against the server module directory, then the cwd.
SERVE_CLIENT=false
CLIENT_DIST_PATH=../../client/dist

# --- Debug access -----------------------------------------------------------
# Debug tooling is gated by explicit authorization, NOT by NODE_ENV, so it works
# in production for whoever is granted it. With none of these set, nobody has
# access anywhere.

# Shared secrets. A client presenting one of these is granted debug access.
# The client sends it via ?debugToken=... (remembered in localStorage afterwards).
DEBUG_TOKENS=

# Display names granted debug access without a token.
# WEAK: players choose their own name, so anyone typing a listed name gets in.
# Use DEBUG_TOKENS instead on any server the public can reach.
DEBUG_PLAYERS=

# Grant every player debug access. Only ever for a private test server.
# NOTE: this does NOT open /admin. Administration accepts DEBUG_TOKENS only --
# it must not be handed to the world by a convenience switch.
DEBUG_ALLOW_ALL=false

# --- NPCs -------------------------------------------------------------------
# Bots are configured at /admin under NPCs, not here -- they are gameplay, and
# gameplay is administered data. Off by default: a server that fills its own
# lobbies without being asked is a surprise.

# --- Administration data ----------------------------------------------------
# Where arenas and configuration overrides are stored. Behind repository
# interfaces, so this can become a database without gameplay code moving.
DATA_DIR=./data

# Whether DATA_DIR survives a restart. Declared, not detected: only you know
# whether it points at a mounted volume. The admin interface shows the answer so
# nobody builds an arena that a redeploy will discard.
DATA_PERSISTENT=false
