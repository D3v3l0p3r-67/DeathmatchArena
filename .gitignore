# Dependencies
node_modules/

# Build output
server/build/
client/dist/
*.tsbuildinfo

# Local environment overrides
.env
.env.*
!.env.example

# Colyseus dev-mode state cache (written into whichever cwd the server runs from)
.devmode.json

# Stored arenas and configuration overrides. Runtime data, not source: the
# server seeds it from the build on first start.
data/

# Logs / editor / OS noise
*.log
npm-debug.log*
.vite/
.DS_Store
.idea/
.vscode/
